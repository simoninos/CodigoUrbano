# Copia este archivo como keystore.properties (en la raíz del proyecto) y escribe tus contraseñas.
# keystore.properties está en .gitignore: las contraseñas nunca llegan al repositorio.
# Con él presente, gradlew assembleRelease genera el APK firmado sin pasar por el asistente.
storeFile=almacen-claves/triskeledu.jks
storePassword=CONTRASENA_DEL_ALMACEN
keyAlias=aprendoia
keyPassword=CONTRASENA_DE_LA_LLAVE