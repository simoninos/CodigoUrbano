<?xml version="1.0" encoding="utf-8"?>
<!-- BKD-01: el backend corre en el computador de la demo, en Docker, con http (sin certificado).
     En la defensa el celular es el punto de acceso y el computador se conecta a su red: el celular le asigna la IP
     y puede cambiar cada vez, así que no se puede dejar una lista fija de direcciones (Android no acepta rangos).
     Por eso se permite http; la dirección del servidor se elige en P01 ("Servidor").
     Lo demás no cambia: Wikipedia, OpenStreetMap y Google Drive se piden con https.
     Para producción: un gateway con certificado (https) y volver a cleartextTrafficPermitted="false" -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
